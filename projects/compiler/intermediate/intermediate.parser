export module otava.intermediate.parser;

[interface]import otava.intermediate.context;
[interface]import otava.intermediate.types;
[interface]import otava.intermediate.code;
[interface]import otava.intermediate.metadata;
[implementation]import otava.intermediate.error;
[implementation]import otava.intermediate.token;
[implementation]import otava.intermediate.lexer;
[implementation]import soul.ast.span;

parser IntermediateParser
{
    lexer otava::intermediate::lexer::IntermediateLexer<char32_t>;
    main;

    PIntermediateFile(otava::intermediate::IntermediateContext* context)
        ::= empty{ context->SetFilePath(lexer.FileName()); }
            PTypeDeclarations(context):types?
            PDataDefinitions(context):data?
            PFunctionDefinitions(context):functions?
            PMetadata(context):metadata?
        ;

    PTypeDeclarations(otava::intermediate::IntermediateContext* context)
        ::= TYPES LBRACE PTypeDeclaration(context):typeDeclaration* RBRACE
        {
            context->ResolveTypes();
        }
        ;

    PTypeDeclaration(otava::intermediate::IntermediateContext* context, var std::int32_t tid)
        ::= PTypeId:typeId{ tid = typeId;} ASSIGN TYPE
        (   PStructureType(context, tid):structureType
        |   PArrayType(context, tid):arrayType
        |   PFunctionType(context, tid):functionType
        )
        ;

    PTypeId : std::int32_t
        ::= 
        (
            TYPEID{ return otava::intermediate::MakeUserTypeId(util::ToUtf8(lexer.GetToken(pos).ToString())); }
        )
        ;

    PFundamentalTypeId : std::int32_t
        ::= VOID{ return otava::intermediate::voidTypeId; }
        |   BOOL{ return otava::intermediate::boolTypeId; }
        |   SBYTE{ return otava::intermediate::sbyteTypeId; }
        |   BYTE{ return otava::intermediate::byteTypeId; }
        |   SHORT{ return otava::intermediate::shortTypeId; }
        |   USHORT{ return otava::intermediate::ushortTypeId; }
        |   INT{ return otava::intermediate::intTypeId; }
        |   UINT{ return otava::intermediate::uintTypeId; }
        |   LONG{ return otava::intermediate::longTypeId; }
        |   ULONG{ return otava::intermediate::ulongTypeId; }
        |   FLOAT{ return otava::intermediate::floatTypeId; }
        |   DOUBLE{ return otava::intermediate::doubleTypeId; }
        ;

    PTypeRef(var soul::ast::Span span, var std::int32_t baseTypeId, var std::int8_t pointerCount) : otava::intermediate::TypeRef
        ::= 
        (
            (   PTypeId:typeId{ span = lexer.GetSpan(pos); baseTypeId = typeId; }
            |   PFundamentalTypeId:fundamentalTypeId{ span = lexer.GetSpan(pos); baseTypeId = fundamentalTypeId; }
            )   
            (AST{ ++pointerCount; })*
        )
        {
            return otava::intermediate::MakeTypeRef(span, baseTypeId, pointerCount); 
        }
        ;

    PStructureType(otava::intermediate::IntermediateContext* context, std::int32_t typeId, var soul::ast::Span span, var std::vector<otava::intermediate::TypeRef> fieldTypeRefs)
        ::= LBRACE{ span = lexer.GetSpan(pos); } 
            (PTypeRef:first{ fieldTypeRefs.push_back(first); } 
            (COMMA PTypeRef:next{ fieldTypeRefs.push_back(next); })*)? 
            RBRACE
            (PMetadataRef(context):mdRef?)
        {
            context->AddStructureType(span, typeId, fieldTypeRefs, mdRef);
        }
        ;

    PArrayType(otava::intermediate::IntermediateContext* context, std::int32_t typeId, var soul::ast::Span span, var std::int64_t size)
        ::= LBRACKET { span = lexer.GetSpan(pos); } 
            NUMBER{ size = lexer.GetToken(pos).ToLong(); } 
            ID{ pass = util::ToUtf8(lexer.GetToken(pos).ToString()) == "x"; } 
            PTypeRef:elementTypeRef
            RBRACKET
        {
            context->AddArrayType(span, typeId, size, elementTypeRef);
        }
        ;

    PFunctionType(otava::intermediate::IntermediateContext* context, std::int32_t typeId, var soul::ast::Span span, var std::vector<otava::intermediate::TypeRef> paramTypeRefs)
        ::= FUNCTION{ span = lexer.GetSpan(pos); } 
            PTypeRef:returnTypeRef 
            LPAREN 
            (PTypeRef:first{ paramTypeRefs.push_back(first); } 
            (COMMA PTypeRef:next{ paramTypeRefs.push_back(next); })*)? 
            RPAREN
        {
            context->AddFunctionType(span, typeId, returnTypeRef, paramTypeRefs);
        }
        ;

    PDataDefinitions(otava::intermediate::IntermediateContext* context) 
        ::= DATA LBRACE PDataDefinition(context):dataDefinition* RBRACE{ context->ResolveData(); }
        ;

    PDataDefinition(otava::intermediate::IntermediateContext* context, 
        var otava::intermediate::TypeRef tref, var soul::ast::Span span, var std::string variableName) 
        ::= PTypeRef:typeRef{ tref = typeRef; context->ResolveType(tref); }  
            ID{ span = lexer.GetSpan(pos); variableName = util::ToUtf8(lexer.GetToken(pos).ToString()); } 
        (   SEMICOLON{ context->AddGlobalVariable(span, tref.GetType(), variableName, nullptr); }
        |   ASSIGN PConstant(context, tref.GetType()):initializer{ context->AddGlobalVariable(span, tref.GetType(), variableName, initializer); }
        )
        ;

    PConstant(otava::intermediate::IntermediateContext* context, otava::intermediate::Type* type) : otava::intermediate::Value*
        ::= PBoolConstant(context):boolConstant{ return boolConstant; }
        |   PSByteConstant(context):sbyteConstant{ return sbyteConstant; }
        |   PByteConstant(context):byteConstant{ return byteConstant; }
        |   PShortConstant(context):shortConstant{ return shortConstant; }
        |   PUShortConstant(context):ushortConstant{ return ushortConstant; }
        |   PIntConstant(context):intConstant{ return intConstant; }
        |   PUIntConstant(context):uintConstant{ return uintConstant; }
        |   PLongConstant(context):longConstant{ return longConstant; }
        |   PULongConstant(context):ulongConstant{ return ulongConstant; }
        |   PFloatConstant(context):floatConstant{ return floatConstant; }
        |   PDoubleConstant(context):doubleConstant{ return doubleConstant; }
        |   PAddressConstant(context):addressConstant{ return addressConstant; }
        |   PArrayConstant(context, type):arrayConstant{ return arrayConstant; }
        |   PStructureConstant(context, type):structureConstant{ return structureConstant; }
        |   PStringConstant(context):stringConstant{ return stringConstant; }
        |   PStringArrayConstant(context):stringArrayConstant{ return stringArrayConstant; }
        |   PConversionConstant(context):conversionConstant{ return conversionConstant; }
        |   PClsIdConstant(context):clsidConstant{ return clsidConstant; }
        |   PSymbolConstant(context):symbolConstant{ return symbolConstant; }
        ;

    PBoolConstant(otava::intermediate::IntermediateContext* context) : otava::intermediate::Value*
        ::= BOOL
        (   TRUE{ return context->GetTrueValue(); }
        |   FALSE{ return context->GetFalseValue(); }
        )
        ;

    PSByteConstant(otava::intermediate::IntermediateContext* context) : otava::intermediate::Value*
        ::= SBYTE NUMBER{ return context->GetSByteValue(lexer.GetToken(pos).ToSByte()); }
        ;

    PByteConstant(otava::intermediate::IntermediateContext* context) : otava::intermediate::Value*
        ::= BYTE NUMBER{ return context->GetByteValue(lexer.GetToken(pos).ToByte()); }
        ;

    PShortConstant(otava::intermediate::IntermediateContext* context) : otava::intermediate::Value*
        ::= SHORT NUMBER{ return context->GetShortValue(lexer.GetToken(pos).ToShort()); }
        ;

    PUShortConstant(otava::intermediate::IntermediateContext* context) : otava::intermediate::Value*
        ::= USHORT NUMBER{ return context->GetUShortValue(lexer.GetToken(pos).ToUShort()); }
        ;

    PIntConstant(otava::intermediate::IntermediateContext* context) : otava::intermediate::Value*
        ::= INT NUMBER{ return context->GetIntValue(lexer.GetToken(pos).ToInt()); }
        ;

    PUIntConstant(otava::intermediate::IntermediateContext* context) : otava::intermediate::Value*
        ::= UINT NUMBER{ return context->GetUIntValue(lexer.GetToken(pos).ToUInt()); }
        ;

    PLongConstant(otava::intermediate::IntermediateContext* context) : otava::intermediate::Value*
        ::= LONG NUMBER{ return context->GetLongValue(lexer.GetToken(pos).ToLong()); }
        ;

    PULongConstant(otava::intermediate::IntermediateContext* context) : otava::intermediate::Value*
        ::= ULONG NUMBER{ return context->GetULongValue(lexer.GetToken(pos).ToULong()); }
        ;

    PFloatConstant(otava::intermediate::IntermediateContext* context) : otava::intermediate::Value*
        ::= FLOAT NUMBER{ return context->GetFloatValue(lexer.GetToken(pos).ToFloat()); }
        ;

    PDoubleConstant(otava::intermediate::IntermediateContext* context) : otava::intermediate::Value*
        ::= DOUBLE NUMBER{ return context->GetDoubleValue(lexer.GetToken(pos).ToDouble()); }
        ;

    PAddressConstant(otava::intermediate::IntermediateContext* context, var otava::intermediate::TypeRef tref) : otava::intermediate::Value*
        ::= PTypeRef:typeRef{ tref = typeRef; context->ResolveType(tref); } 
        (   NULL_TOKEN
            {
                return context->GetNullValue(lexer.GetSpan(pos), tref.GetType());
            }
        |   ID
            { 
                return context->MakeAddressLiteral(lexer.GetSpan(pos), tref.GetType(), util::ToUtf8(lexer.GetToken(pos).ToString()), false); 
            }
        )
        ;

    PArrayConstant(otava::intermediate::IntermediateContext* context, otava::intermediate::Type* type, var otava::intermediate::ArrayType* arrayType, 
        var otava::intermediate::Type* elementType,
        var soul::ast::Span span, var std::vector<otava::intermediate::Value*> elements) : otava::intermediate::Value*
        ::= LBRACKET{ span = lexer.GetSpan(pos); arrayType = static_cast<otava::intermediate::ArrayType*>(type->BaseType()); elementType = arrayType->ElementType(); } 
            (PConstant(context, elementType):first{ elements.push_back(first); } 
            (COMMA PConstant(context, elementType):next{ elements.push_back(next); })*)? 
            RBRACKET
        {
            return context->MakeArrayValue(span, elements, arrayType);
        }
        ;

    PStructureConstant(otava::intermediate::IntermediateContext* context, otava::intermediate::Type* type, var otava::intermediate::StructureType* structureType, var int index,
        var soul::ast::Span span, var std::vector<otava::intermediate::Value*> fieldValues) : otava::intermediate::Value*
        ::= LBRACE{ span = lexer.GetSpan(pos); structureType = static_cast<otava::intermediate::StructureType*>(type->BaseType()); }
            (PConstant(context, structureType->FieldType(index++)):first{ fieldValues.push_back(first); }
            (COMMA PConstant(context, structureType->FieldType(index++)):next{ fieldValues.push_back(next); })*)?
            RBRACE
        {
            return context->MakeStructureValue(span, fieldValues, structureType);
        }
        ;

    PStringConstant(otava::intermediate::IntermediateContext* context, var soul::ast::Span span) : otava::intermediate::Value*
        ::= STRING{ return context->MakeStringValue(lexer.GetSpan(pos), util::ToUtf8(lexer.GetToken(pos).ToString()), true); }
        ;

    PStringArrayConstant(otava::intermediate::IntermediateContext* context, 
        var soul::ast::Span span, var std::vector<otava::intermediate::Value*> elements) : otava::intermediate::Value*
        ::= PStringArrayPrefix:prefix{ span = lexer.GetSpan(pos); } 
            LBRACKET 
            (PConstant(context, nullptr):first{ elements.push_back(first); } 
            (COMMA PConstant(context, nullptr):next{ elements.push_back(next); })*)? 
            RBRACKET
        {
            return context->MakeStringArrayValue(span, prefix, elements);
        }
        ;

    PStringArrayPrefix : char
        ::= ID{ std::string p = util::ToUtf8(lexer.GetToken(pos).ToString()); pass = p == "u" || p == "w" || p == "b"; if (pass) { return p[0]; } }
        ;

    PConversionConstant(otava::intermediate::IntermediateContext* context, var otava::intermediate::TypeRef tref, var soul::ast::Span span) : otava::intermediate::Value*
        ::= PTypeRef:typeRef{ tref = typeRef; context->ResolveType(tref); span = lexer.GetSpan(pos); } CONV LPAREN PConstant(context, nullptr):from RPAREN
        {
            return context->MakeConversionValue(span, tref.GetType(), from);
        }
        ;

    PClsIdConstant(otava::intermediate::IntermediateContext* context, var otava::intermediate::TypeRef tref, var soul::ast::Span span) : otava::intermediate::Value*
        ::= PTypeRef:typeRef{ tref = typeRef; context->ResolveType(tref); span = lexer.GetSpan(pos); } CLSID 
        {
            return context->MakeClsIdValue(span, tref.GetType(), util::ToUtf8(lexer.GetToken(pos).ToString()));
        }
        ;

    PSymbolConstant(otava::intermediate::IntermediateContext* context, var otava::intermediate::TypeRef tref) : otava::intermediate::Value*
        ::= PTypeRef:typeRef{ tref = typeRef; context->ResolveType(tref); } PSymbolValue(context, tref.GetType()):symbolValue
        {
            return symbolValue;
        }
        ;

    PValue(otava::intermediate::IntermediateContext* context, otava::intermediate::Type* type) : otava::intermediate::Value*
        ::= PRegValue(context, type):regValue{ return regValue; }
        |   PSymbolValue(context, type):symbolValue{ return symbolValue; }
        |   PLiteralValue(context, type):literalValue{ return literalValue; }
        ;

    PRegValue(otava::intermediate::IntermediateContext* context, otava::intermediate::Type* type, var soul::ast::Span span) : otava::intermediate::Value*
        ::= DOLLAR{ span = lexer.GetSpan(pos); } 
            NUMBER{ span.Union(lexer.GetSpan(pos)); std::int32_t reg = lexer.GetToken(pos).ToInt(); return context->CurrentFunction()->GetRegRef(span, type, reg, context); }
        ;

    PResultRegValue(otava::intermediate::IntermediateContext* context, otava::intermediate::Type* type, var soul::ast::Span span) : otava::intermediate::RegValue*
        ::= DOLLAR{ span = lexer.GetSpan(pos); } 
            NUMBER{ span.Union(lexer.GetSpan(pos)); std::int32_t reg = lexer.GetToken(pos).ToInt(); return context->CurrentFunction()->MakeRegValue(span, type, reg, context); }
        ;

    PSymbolValue(otava::intermediate::IntermediateContext* context, otava::intermediate::Type* type, var soul::ast::Span span) : otava::intermediate::Value*
        ::= AT{ span = lexer.GetSpan(pos); } ID{ span.Union(lexer.GetSpan(pos)); return context->MakeSymbolValue(span, type, util::ToUtf8(lexer.GetToken(pos).ToString()));  }
        ;

    PLiteralValue(otava::intermediate::IntermediateContext* context, otava::intermediate::Type* type) : otava::intermediate::Value*
        ::= TRUE{ return context->GetBooleanLiteral(lexer.GetSpan(pos), type, true); }
        |   FALSE{ return context->GetBooleanLiteral(lexer.GetSpan(pos), type, false); }
        |   NULL_TOKEN{ return context->GetNullValue(lexer.GetSpan(pos), type); }
        |   NUMBER{ return context->MakeIntegerLiteral(lexer.GetSpan(pos), type, util::ToUtf8(lexer.GetToken(pos).ToString())); }
        |   ID{ return context->MakeAddressLiteral(lexer.GetSpan(pos), type, util::ToUtf8(lexer.GetToken(pos).ToString()), true); }
        ;

    PFunctionDefinitions(otava::intermediate::IntermediateContext* context)
        ::= 
            (   PFunctionDeclaration(context):declaration
            |   PFunctionDefinition(context):function
            )*
        ;

    PFunctionDeclaration(otava::intermediate::IntermediateContext* context, var otava::intermediate::TypeRef functionTypeRef, 
        var soul::ast::Span span, var std::string functionId) 
        ::= 
        (   
            EXTERN{ span = lexer.GetSpan(pos); } 
            FUNCTION 
            PTypeRef:typeRef{ functionTypeRef = typeRef; context->ResolveType(functionTypeRef); } 
            ID{ functionId = util::ToUtf8(lexer.GetToken(pos).ToString()); } 
        )
        {
            context->AddFunctionDeclaration(span, functionTypeRef.GetType(), functionId);
        }
        ;

    PFunctionDefinition(otava::intermediate::IntermediateContext* context, var otava::intermediate::Function* function)
        ::= PFunctionHeader(context):header{ function = header; context->SetCurrentFunction(function); } LBRACE PBasicBlock(context, function):basicBlock* RBRACE
        ;

    PFunctionHeader(otava::intermediate::IntermediateContext* context, 
        var otava::intermediate::TypeRef functionTypeRef, var soul::ast::Span span, var std::string functionId, var bool inline_, var bool linkOnce, var bool child) : 
            otava::intermediate::Function*
        ::= 
        (   
            (INLINE{ inline_ = true; })?
            (LINK_ONCE{ linkOnce = true; })?
            (CHILD{ child = true; })?
            FUNCTION{ span = lexer.GetSpan(pos); } 
            PTypeRef:typeRef{ functionTypeRef = typeRef; context->ResolveType(functionTypeRef); } 
            ID{ functionId = util::ToUtf8(lexer.GetToken(pos).ToString()); } 
            PMetadataRef(context):mdRef?
        )
        {
            return context->AddFunctionDefinition(span, functionTypeRef.GetType(), functionId, inline_, linkOnce, child, false, mdRef);
        }
        ;

    PBasicBlock(otava::intermediate::IntermediateContext* context, otava::intermediate::Function* function, var otava::intermediate::BasicBlock* basicBlock, 
        var soul::ast::Span span)
        ::= PLabel:id{ span = lexer.GetSpan(pos); basicBlock = function->AddBasicBlock(span, id, context); } PInstructions(context, basicBlock):instructions
        ;

    PLabel : std::int32_t
        ::= AT NUMBER{ return lexer.GetToken(pos).ToInt(); }
        ;

    POperand(otava::intermediate::IntermediateContext* context, var otava::intermediate::TypeRef tref) : otava::intermediate::Value*
        ::= PTypeRef:typeRef{ tref = typeRef; context->ResolveType(tref); } PValue(context, tref.GetType()):value
        {
            return value;
        }
        ;

    PInstructions(otava::intermediate::IntermediateContext* context, otava::intermediate::BasicBlock* basicBlock)
        ::= 
        (
            PInstruction(context):instruction{ basicBlock->DoAddInstruction(instruction); }
        )+
        ;

    PInstruction(otava::intermediate::IntermediateContext* context) : otava::intermediate::Instruction*
        ::= PStoreInstruction(context):store{ return store; }
        |   PArgInstruction(context):arg{ return arg; }
        |   PJmpInstruction(context):jmp{ return jmp; }
        |   PBranchInstruction(context):branch{ return branch; }
        |   PProcedureCallInstruction(context):procedureCall{ return procedureCall; }
        |   PRetInstruction(context):ret{ return ret; }
        |   PSwitchInstruction(context):switch_{ return switch_; }
        |   PValueInstruction(context):valueInst{ return valueInst; }
        |   PNoOperationInstruction(context):nopInst{ return nopInst; }
        ;

    PStoreInstruction(otava::intermediate::IntermediateContext* context, 
        var soul::ast::Span span, var otava::intermediate::TypeRef tref, var otava::intermediate::TypeRef ptref) : otava::intermediate::Instruction*
        ::= STORE{ span = lexer.GetSpan(pos); }
            PTypeRef:typeRef{ tref = typeRef; context->ResolveType(tref); } 
            PValue(context, tref.GetType()):value 
            COMMA 
            PTypeRef:ptrTypeRef{ ptref = ptrTypeRef; context->ResolveType(ptref); }
            PValue(context, ptref.GetType()):ptr
        {
            return new otava::intermediate::StoreInstruction(span, value, ptr);
        }
        ;

    PArgInstruction(otava::intermediate::IntermediateContext* context, var soul::ast::Span span, var otava::intermediate::TypeRef tref) : otava::intermediate::Instruction*
        ::= ARG{ span = lexer.GetSpan(pos); }
            PTypeRef:typeRef{ tref = typeRef; context->ResolveType(tref); } 
            PValue(context, tref.GetType()):arg
        {
            return new otava::intermediate::ArgInstruction(span, arg);
        }
        ;

    PJmpInstruction(otava::intermediate::IntermediateContext* context, var soul::ast::Span span) : otava::intermediate::Instruction*
        ::= JMP{ span = lexer.GetSpan(pos); }
            PLabel:target
        {
            return new otava::intermediate::JmpInstruction(span, target);
        }
        ;

    PBranchInstruction(otava::intermediate::IntermediateContext* context, var soul::ast::Span span, var otava::intermediate::TypeRef tref) : otava::intermediate::Instruction*
        ::= BRANCH{ span = lexer.GetSpan(pos); }
            PTypeRef:typeRef{ tref = typeRef; context->ResolveType(tref); }
            PValue(context, tref.GetType()):cond
            COMMA
            PLabel:trueTarget
            COMMA
            PLabel:falseTarget
        {
            return new otava::intermediate::BranchInstruction(span, cond, trueTarget, falseTarget);
        }
        ;

    PProcedureCallInstruction(otava::intermediate::IntermediateContext* context, 
        var soul::ast::Span span, var otava::intermediate::TypeRef tref) : otava::intermediate::Instruction*
        ::= CALL{ span = lexer.GetSpan(pos); }
            PTypeRef:typeRef{ tref = typeRef; context->ResolveType(tref); }
            PValue(context, tref.GetType()):callee
        {
            return new otava::intermediate::ProcedureCallInstruction(span, callee);
        }
        ;

    PRetInstruction(otava::intermediate::IntermediateContext* context, var soul::ast::Span span, var otava::intermediate::TypeRef tref) : 
        otava::intermediate::Instruction*
        ::= RET{ span = lexer.GetSpan(pos); }
        (   (VOID - (VOID AST)){ return new otava::intermediate::RetInstruction(span, nullptr); }
        |   PTypeRef:typeRef{ tref = typeRef; context->ResolveType(tref); }  
            PValue(context, tref.GetType()):returnValue{ return new otava::intermediate::RetInstruction(span, returnValue); }
        )
        ;

    PSwitchInstruction(otava::intermediate::IntermediateContext* context, 
        var soul::ast::Span span, var otava::intermediate::TypeRef tref, var otava::intermediate::TypeRef caseTref, 
        var otava::intermediate::SwitchInstruction* inst) : otava::intermediate::Instruction*
        ::= 
        (
            SWITCH{ span = lexer.GetSpan(pos); }
            PTypeRef:typeRef{ tref = typeRef; context->ResolveType(tref); }  
            PValue(context, tref.GetType()):cond
            PLabel:defaultTarget{ inst = new otava::intermediate::SwitchInstruction(span, cond, defaultTarget); }
            COMMA
            LBRACKET
            (
                (   PTypeRef:caseTypeRef{ caseTref = caseTypeRef; context->ResolveType(caseTref); }
                    PValue(context, caseTref.GetType()):caseValue
                    COMMA
                    PLabel:caseTarget{ inst->AddCaseTarget(otava::intermediate::CaseTarget(caseValue, caseTarget)); }
                ) % COLON
            )
            RBRACKET
        )
        {
            return inst;
        }
        ;

    PValueInstruction(otava::intermediate::IntermediateContext* context, var otava::intermediate::TypeRef tref, var otava::intermediate::RegValue* rslt) : 
        otava::intermediate::Instruction*
        ::= PTypeRef:typeRef{ tref = typeRef; context->ResolveType(tref); } PResultRegValue(context, tref.GetType()):result{ rslt = result; } ASSIGN POperation(context, rslt):inst
        {
            return inst;
        }
        ;

    POperation(otava::intermediate::IntermediateContext* context, otava::intermediate::RegValue* result) : otava::intermediate::Instruction*
        ::= PUnaryInstruction(context, result):unaryInst{ return unaryInst; }
        |   PBinaryInstruction(context, result):binaryInst{ return binaryInst; }
        |   PParamInstruction(context, result):paramInst{ return paramInst; }
        |   PLocalInstruction(context, result):localInst{ return localInst; }
        |   PPLocalInstruction(context, result):plocalInst{ return plocalInst; }
        |   PLoadInstruction(context, result):loadInst{ return loadInst; }
        |   PElemAddrInstruction(context, result):elemAddrInst{ return elemAddrInst; }
        |   PPtrOffsetInstruction(context, result):ptrOffsetInst{ return ptrOffsetInst; }
        |   PPtrDiffInstruction(context, result):ptrDiffInst{ return ptrDiffInst; }
        |   PGetRbpInstruction(context, result):getRbpInst{ return getRbpInst; }
        |   PFunctionCallInstruction(context, result):functionCallInst{ return functionCallInst; }
        ;

    PUnaryInstruction(otava::intermediate::IntermediateContext* context, otava::intermediate::RegValue* result, var soul::ast::Span span) : otava::intermediate::Instruction*
        ::= NOT{ span = lexer.GetSpan(pos); } POperand(context):notOp{ return new otava::intermediate::NotInstruction(span, result, notOp); }
        |   NEG{ span = lexer.GetSpan(pos); } POperand(context):negOp{ return new otava::intermediate::NegInstruction(span, result, negOp); }
        |   SIGNEXTEND{ span = lexer.GetSpan(pos); } POperand(context):sextOp{ return new otava::intermediate::SignExtendInstruction(span, result, sextOp); }
        |   ZEROEXTEND{ span = lexer.GetSpan(pos); } POperand(context):zextOp{ return new otava::intermediate::ZeroExtendInstruction(span, result, zextOp); }
        |   FPEXTEND{ span = lexer.GetSpan(pos); } POperand(context):fpextOp{ return new otava::intermediate::FloatingPointExtendInstruction(span, result, fpextOp); }
        |   TRUNCATE{ span = lexer.GetSpan(pos); } POperand(context):truncOp{ return new otava::intermediate::TruncateInstruction(span, result, truncOp); }
        |   BITCAST{ span = lexer.GetSpan(pos); } POperand(context):bcOp{ return new otava::intermediate::BitcastInstruction(span, result, bcOp); }
        |   INTTOFLOAT{ span = lexer.GetSpan(pos); } POperand(context):ifOp{ return new otava::intermediate::IntToFloatInstruction(span, result, ifOp); }
        |   FLOATTOINT{ span = lexer.GetSpan(pos); } POperand(context):fiOp{ return new otava::intermediate::FloatToIntInstruction(span, result, fiOp); }
        |   INTTOPTR{ span = lexer.GetSpan(pos); } POperand(context):ipOp{ return new otava::intermediate::IntToPtrInstruction(span, result, ipOp); }
        |   PTRTOINT{ span = lexer.GetSpan(pos); } POperand(context):piOp{ return new otava::intermediate::PtrToIntInstruction(span, result, piOp); }
        ;

    PBinaryInstruction(otava::intermediate::IntermediateContext* context, otava::intermediate::RegValue* result, var soul::ast::Span span) : otava::intermediate::Instruction*
        ::= 
        (   ADD{ span = lexer.GetSpan(pos); } 
            POperand(context):leftAdd 
            COMMA 
            POperand(context):rightAdd
        )
        { 
            return new otava::intermediate::AddInstruction(span, result, leftAdd, rightAdd); 
        }
        |   
        (   SUB{ span = lexer.GetSpan(pos); } 
            POperand(context):leftSub 
            COMMA 
            POperand(context):rightSub
        )
        { 
            return new otava::intermediate::SubInstruction(span, result, leftSub, rightSub); 
        }
        |   
        (   MUL{ span = lexer.GetSpan(pos); } 
            POperand(context):leftMul 
            COMMA 
            POperand(context):rightMul
        )
        { 
            return new otava::intermediate::MulInstruction(span, result, leftMul, rightMul); 
        }
        |   
        (   DIV{ span = lexer.GetSpan(pos); } 
            POperand(context):leftDiv 
            COMMA 
            POperand(context):rightDiv
        )
        { 
            return new otava::intermediate::DivInstruction(span, result, leftDiv, rightDiv); 
        }
        |   
        (   MOD{ span = lexer.GetSpan(pos); } 
            POperand(context):leftMod 
            COMMA 
            POperand(context):rightMod
        )
        { 
            return new otava::intermediate::ModInstruction(span, result, leftMod, rightMod); 
        }
        |
        (   AND{ span = lexer.GetSpan(pos); } 
            POperand(context):leftAnd 
            COMMA 
            POperand(context):rightAnd
        )
        { 
            return new otava::intermediate::AndInstruction(span, result, leftAnd, rightAnd); 
        }
        |   
        (   OR{ span = lexer.GetSpan(pos); } 
            POperand(context):leftOr 
            COMMA 
            POperand(context):rightOr
        )
        { 
            return new otava::intermediate::OrInstruction(span, result, leftOr, rightOr); 
        }
        |   
        (   XOR{ span = lexer.GetSpan(pos); } 
            POperand(context):leftXor 
            COMMA 
            POperand(context):rightXor
        )
        { 
            return new otava::intermediate::XorInstruction(span, result, leftXor, rightXor); 
        }
        |   
        (   SHL{ span = lexer.GetSpan(pos); } 
            POperand(context):leftShl 
            COMMA 
            POperand(context):rightShl
        )
        { 
            return new otava::intermediate::ShlInstruction(span, result, leftShl, rightShl); 
        }
        |   
        (   SHR{ span = lexer.GetSpan(pos); } 
            POperand(context):leftShr 
            COMMA 
            POperand(context):rightShr
        )
        { 
            return new otava::intermediate::ShrInstruction(span, result, leftShr, rightShr); 
        }
        |   
        (   EQUAL{ span = lexer.GetSpan(pos); } 
            POperand(context):leftEqual 
            COMMA 
            POperand(context):rightEqual
        )
        { 
            return new otava::intermediate::EqualInstruction(span, result, leftEqual, rightEqual); 
        }
        |   
        (   LESS{ span = lexer.GetSpan(pos); } 
            POperand(context):leftLess 
            COMMA 
            POperand(context):rightLess
        )
        { 
            return new otava::intermediate::LessInstruction(span, result, leftLess, rightLess); 
        }
        ;

    PParamInstruction(otava::intermediate::IntermediateContext* context, otava::intermediate::RegValue* result, var soul::ast::Span span) : 
        otava::intermediate::Instruction*
        ::= PARAM{ span = lexer.GetSpan(pos); return new otava::intermediate::ParamInstruction(span, result); }
        ;

    PLocalInstruction(otava::intermediate::IntermediateContext* context, otava::intermediate::RegValue* result, var soul::ast::Span span, 
        var otava::intermediate::TypeRef tref) : otava::intermediate::Instruction*
        ::= LOCAL{ span = lexer.GetSpan(pos); } 
            PTypeRef:typeRef{ tref = typeRef; context->ResolveType(tref); return new otava::intermediate::LocalInstruction(span, result, tref.GetType()); }
        ;

    PPLocalInstruction(otava::intermediate::IntermediateContext* context, otava::intermediate::RegValue* result, var soul::ast::Span span, 
        var otava::intermediate::TypeRef tref, var int level) : otava::intermediate::Instruction*
        ::= 
        (
            PLOCAL{ span = lexer.GetSpan(pos); }
            PTypeRef:typeRef{ tref = typeRef; context->ResolveType(tref); }
            COMMA
            NUMBER{ level = lexer.GetToken(pos).ToInt(); } 
        )
        {
            return new otava::intermediate::PLocalInstruction(span, result, tref.GetType(), level);
        }
        ;

    PLoadInstruction(otava::intermediate::IntermediateContext* context, otava::intermediate::RegValue* result, var soul::ast::Span span) : otava::intermediate::Instruction*
        ::= LOAD{ span = lexer.GetSpan(pos); } POperand(context):ptr{ return new otava::intermediate::LoadInstruction(span, result, ptr); }
        ;

    PElemAddrInstruction(otava::intermediate::IntermediateContext* context, otava::intermediate::RegValue* result, var soul::ast::Span span) : 
        otava::intermediate::Instruction*
        ::= ELEMADDR{ span = lexer.GetSpan(pos); } POperand(context):ptr COMMA POperand(context):index
        { 
            return new otava::intermediate::ElemAddrInstruction(span, result, ptr, index); 
        }
        ;

    PPtrOffsetInstruction(otava::intermediate::IntermediateContext* context, otava::intermediate::RegValue* result, var soul::ast::Span span) : 
        otava::intermediate::Instruction*
        ::= PTROFFSET{ span = lexer.GetSpan(pos); } POperand(context):ptr COMMA POperand(context):offset
        { 
            return new otava::intermediate::PtrOffsetInstruction(span, result, ptr, offset); 
        }
        ;

    PPtrDiffInstruction(otava::intermediate::IntermediateContext* context, otava::intermediate::RegValue* result, var soul::ast::Span span) : 
        otava::intermediate::Instruction*
        ::= PTRDIFF{ span = lexer.GetSpan(pos); } POperand(context):leftPtr COMMA POperand(context):rightPtr
        { 
            return new otava::intermediate::PtrDiffInstruction(span, result, leftPtr, rightPtr); 
        }
        ;

    PGetRbpInstruction(otava::intermediate::IntermediateContext* context, otava::intermediate::RegValue* result, var soul::ast::Span span) : 
        otava::intermediate::Instruction*
        ::= 
        (
            GETRBP{ span = lexer.GetSpan(pos); } 
        )
        {
            return new otava::intermediate::GetRbpInstruction(span, result); 
        }
        ;

    PFunctionCallInstruction(otava::intermediate::IntermediateContext* context, otava::intermediate::RegValue* result, var otava::intermediate::TypeRef tref, 
        var soul::ast::Span span) : otava::intermediate::Instruction*
        ::= CALL{ span = lexer.GetSpan(pos); } PTypeRef:typeRef{ tref = typeRef; context->ResolveType(tref); } PValue(context, tref.GetType()):callee
        { 
            return new otava::intermediate::FunctionCallInstruction(span, result, callee);
        }
        ;

    PBlockValue(otava::intermediate::IntermediateContext* context) : otava::intermediate::BlockValue
        ::= 
        (
            LBRACKET POperand(context):operand COMMA PLabel:blockId RBRACKET
        )
        {
            return otava::intermediate::BlockValue(operand, blockId);
        }
        ;

    PNoOperationInstruction(otava::intermediate::IntermediateContext* context, var soul::ast::Span span) : otava::intermediate::Instruction*
        ::= NOP{ span = lexer.GetSpan(pos); return new otava::intermediate::NoOperationInstruction(span); }
        ;

    PMetadata(otava::intermediate::IntermediateContext* context)
        ::= METADATA LBRACE PMetadataStruct(context):mds* RBRACE
        {
            context->ResolveMetadataReferences();
        }
        ;

    PMetadataStruct(otava::intermediate::IntermediateContext* context, var otava::intermediate::MetadataStruct* value)
        ::= EXCLAMATION NUMBER{ value = context->AddMetadataStruct(lexer.GetSpan(pos), lexer.GetToken(pos).ToInt()); }
            ASSIGN 
            LBRACE
            (PMetadataField(context, value):first (COMMA PMetadataField(context, value):next)*)?
            RBRACE
        ;

    PMetadataField(otava::intermediate::IntermediateContext* context, otava::intermediate::MetadataStruct* parent, var std::string fieldName)
        ::= ID{ fieldName = util::ToUtf8(lexer.GetToken(pos).ToString()); } COLON PMetadataItem(context):item{ parent->AddItem(fieldName, item); }
        ;

    PMetadataItem(otava::intermediate::IntermediateContext* context) : otava::intermediate::MetadataItem*
        ::= PMetadataBool(context):mdBool{ return mdBool; }
        |   PMetadataLong(context):mdLong{ return mdLong; }
        |   PMetadataString(context):mdString{ return mdString; }
        |   PMetadataRef(context):mdRef{ return mdRef; }
        ;

    PMetadataBool(otava::intermediate::IntermediateContext* context) : otava::intermediate::MetadataItem*
        ::= TRUE{ return context->CreateMetadataBool(true); }
        |   FALSE{ return context->CreateMetadataBool(false); }
        ;

    PMetadataLong(otava::intermediate::IntermediateContext* context) : otava::intermediate::MetadataItem*
        ::= NUMBER{ return context->CreateMetadataLong(lexer.GetToken(pos).ToLong()); }
        ;

    PMetadataString(otava::intermediate::IntermediateContext* context) : otava::intermediate::MetadataItem*
        ::= STRING{ return context->CreateMetadataString(util::ToUtf8(lexer.GetToken(pos).ToString()), true); }
        ;

    PMetadataRef(otava::intermediate::IntermediateContext* context) : otava::intermediate::MetadataRef*
        ::= EXCLAMATION NUMBER{ return context->CreateMetadataRef(lexer.GetSpan(pos), lexer.GetToken(pos).ToInt()); }
        ;
                
}
